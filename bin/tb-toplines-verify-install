#!/usr/bin/env python3
"""Install-provenance gate for TopLines.

Fail-closed check run BEFORE any TopLines unit is copied or activated. It
computes the sha256 of every deployed TopLines artifact under the install root
and ABORTS (nonzero exit, nothing installed or activated) on ANY mismatch
against the pinned reviewed-clean set.

The pins identify one release candidate. The portability R5 artifacts preserve
the 2026-09-16 running-turn headline correction and must receive an independent
reviewed-clean verdict before install. Unchanged artifacts retain the prior
reviewed release's provenance below. Generated
outputs (web/toplines.json, web/parity.json) are runtime state, not deployed
artifacts, and are never pinned. docs/runbook.md is documentation, not a
runtime artifact, and does not pin itself.

Usage:
    tb-toplines-verify-install [--root DIR]

Exit status:
    0  every pinned artifact is present and matches its reviewed-clean sha256
    1  one or more artifacts are missing or altered -> DO NOT install/activate
"""

from __future__ import annotations

import argparse
import hashlib
import sys
from pathlib import Path


# Fixed production install root. Verifying a different tree (tests, scratch) is
# done only through the explicit --root argument, never an environment override:
# a silent env redirect could make the gate verify one tree while the runbook
# installs another, defeating the fail-closed guarantee.
ROOT_DEFAULT = Path.home() / "tb-toplines"

# Pinned reviewed-clean sha256 of every deployed TopLines artifact -- the whole
# set the gate protects. Adding or removing a deployed artifact means editing
# this table under review. docs/runbook.md is deliberately NOT pinned: it is the
# gate's own host file and a gate cannot pre-verify the document that carries it.
#
# PRIOR-RELEASE PIN PROVENANCE (PO-locked, wi_f9a21185; state residual):
# TIER A blob-cryptographic vs 26a3641 = 4 gate-pinned artifacts: parity 09de23f1, ts cd307aed, tb-toplines-parity.service d070d2ca, tb-toplines-parity.timer bd7d6af5.
# GEN b1d4c392: authoritative reviewed sha + installed match + Acc2 functional.
# TIER B (independent reviewer-commit-anchored + installed==pin + redeploy record att_b5a53254 + functional; reviewed git-objects reaped => NOT blob-cryptographic): gen->reviewed-clean @6853091 (att_24278bde); web/index.html->reviewed-clean @36a4b4f9 (att_82cde5af); serve+watch->reviewed-clean @8d33eb23 (asg_04c93305); tb-toplines.service+tb-toplines-watch.service->reviewed-clean @8d33eb23 (asg_04c93305).
# docs/runbook.md = reviewed 26a3641 base + the R1-reviewed newly-authored install-gate delta -- provenance is reviewed-base + THIS (R1) review, NOT a 26a3641 cryptographic match.
# RESIDUAL: Tier-B installed<->reviewed-commit link is reviewer-anchored + functional, NOT blob-cryptographic. Do NOT cite att#6/att_d117b2c2 or the superseded pre-D19 page sha b39347c8.
# CURRENT RELEASE CANDIDATE (wi_06502874): portability R5 across generator,
# watcher, parity, page and systemd, preserving the running-turn headline.
# Install only after independent review clears the exact candidate commit.
PINS: dict[str, str] = {
    "bin/tb-toplines-gen": "355ce9a53dc834aebb7a63e71e49dc6d312b6b1a6b8eb832e4b1244dae4af28b",
    "bin/tb-toplines-parity": "e8a85979b0c06fe5906bac894461327e3eb9460c72d94403a332a12fa9dbdd51",
    "bin/tb-toplines-serve": "81e905f676f45e2a9270292d1fdf23b09fc29fc49ac4041f959de538bcc44182",
    "bin/tb-toplines-watch": "34a4ea6f193bb987275bd02214caf1e132ab4b992b55f097c7f82b75675b26e0",
    "bin/tb-toplines-ts": "cd307aedea5cc010075f3e4355a3c12b26237e3501a56e156784e3ccd554b506",
    "web/index.html": "41e39191a971950b1e6832de1c5a019d42ac841d23cf91879bd721d8466282aa",
    "systemd/tb-toplines.service": "7a8e4a03d6851fb71d9432839662060860088f5a5384575e66cd9831335c5abe",
    "systemd/tb-toplines-watch.service": "e909efac9770a0276d82552499389fa98415167a1164a84c82ad747d17dd329a",
    "systemd/tb-toplines-parity.service": "82fd7d165dc4f1314cbe9c8958ed860cb3f49e26b96f1ded1f0e13f566a86ad8",
    "systemd/tb-toplines-parity.timer": "9c06b0c70221e005f2a4e64ac7faf440798ff37f638f3745e7e85723fc6e089a",
}


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 16), b""):
            digest.update(chunk)
    return digest.hexdigest()


def verify(root: Path) -> list[str]:
    """Return human-readable failures; an empty list means every pin matches."""
    failures: list[str] = []
    for relpath, pinned in sorted(PINS.items()):
        target = root / relpath
        if not target.is_file():
            failures.append(f"MISSING  {relpath} (expected {pinned})")
            continue
        actual = sha256_of(target)
        if actual != pinned:
            failures.append(
                f"ALTERED  {relpath}\n"
                f"           expected {pinned}\n"
                f"           found    {actual}"
            )
    return failures


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="TopLines install-provenance gate (fail-closed)"
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=ROOT_DEFAULT,
        help=f"install root to verify (default {ROOT_DEFAULT})",
    )
    args = parser.parse_args(argv)
    root = args.root.expanduser()

    failures = verify(root)
    if failures:
        print(
            f"tb-toplines install gate: ABORT — {len(failures)} of {len(PINS)} "
            f"artifact(s) do not match the reviewed-clean pin set under {root}",
            file=sys.stderr,
        )
        for line in failures:
            print(f"  {line}", file=sys.stderr)
        print(
            "Nothing has been installed or activated. Resolve artifact "
            "provenance before continuing (docs/runbook.md, "
            "\"Install-provenance gate\").",
            file=sys.stderr,
        )
        return 1
    print(
        f"tb-toplines install gate: OK — all {len(PINS)} deployed artifacts "
        f"match the reviewed-clean pin set under {root}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
