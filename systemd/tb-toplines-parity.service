[Unit]
Description=Check TopLines parity against Tightbeam and ATC

[Service]
Type=oneshot
Environment=PATH=%h/.tightbeam/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/tb-toplines/toplines.env
WorkingDirectory=%h/tb-toplines
ExecStart=%h/tb-toplines/bin/tb-toplines-parity
